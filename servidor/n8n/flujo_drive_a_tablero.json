    520,
    100
   ]
  },
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "triggerAtHour": 6,
       "triggerAtMinute": 45
      }
     ]
    }
   },
   "id": "a58318bd-5c9c-5692-8eab-f092f671761d",
   "name": "Todos los días 6:45",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    520,
    360
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://cargador:8000/procesar",
    "options": {
     "timeout": 300000
    }
   },
   "id": "d8e7c046-cfa4-5aa1-aa56-c610cad4d4d9",
   "name": "Correr el pipeline",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    200
   ],
   "executeOnce": true,
   "notes": "Corre el pipeline completo. Un mes se carga solo si están sus 4 archivos; si no, queda pendiente y el tablero lo muestra."
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "3cd0c0a1-a6e8-589e-b311-3fc83909a4a3",
       "leftValue": "={{ ($json.errores_nuevos || []).length }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "5ab0be1b-c59c-5f07-b2ed-ca32e290aaab",
   "name": "¿Error nuevo?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1040,
    200
   ]
  },
  {
   "parameters": {
    "fromEmail": "PEGAR_REMITENTE",
    "toEmail": "PEGAR_MAILS_DEL_EQUIPO",
    "subject": "Tablero DAO: un archivo no se pudo cargar",
    "emailFormat": "text",
    "text": "={{ $json.errores_nuevos.map(e => e.archivo + ': ' + e.error).join('\\n') }}\n\nEl detalle está en la franja roja del tablero.",
    "options": {}
   },
   "id": "98eba504-19c3-5aae-97e7-921b2ab5163b",
   "name": "Avisar al equipo",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
